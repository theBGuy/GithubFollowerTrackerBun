# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_tracker

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_or_org_name
GITHUB_IS_ORG=false  # Set to true if monitoring an organization

# Notification Channels (enable at least one)
ENABLE_EMAIL=false
ENABLE_SLACK=false
ENABLE_DISCORD=false

# Email Configuration (required if ENABLE_EMAIL=true)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com

# Slack Configuration (required if ENABLE_SLACK=true)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord Configuration (required if ENABLE_DISCORD=true)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# Scheduling
# Cron expression format: "second minute hour day month dayOfWeek"
# Default: "0 * * * *" (every hour at minute 0)
# Examples:
#   "0 * * * *"      - Every hour
#   "0 */6 * * *"    - Every 6 hours
#   "0 0 */12 * *"   - Every 12 hours
#   "0 0 * * *"      - Every day at midnight
CHECK_INTERVAL=0 * * * *
